  "components": {
    "schemas": {
      "AddonSummary": {
        "type": "object",
        "required": [
          "installation_id",
          "allow_local",
          "enabled",
          "manifest"
        ],
        "properties": {
          "allow_local": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "installation_id": {
            "type": "string"
          },
          "manifest": {
            "$ref": "#/components/schemas/Manifest"
          }
        }
      },
      "Catalog": {
        "type": "object",
        "required": [
          "type",
          "id"
        ],
        "properties": {
          "extra": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Extra"
            }
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "additionalProperties": {}
      },
      "CreateProfileRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "kids": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "pin": {
            "type": "string"
          }
        }
      },
      "Extra": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "isRequired": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "options": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "optionsLimit": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      },
      "InstallAddonRequest": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "allow_local": {
            "type": "boolean"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "ItemKey": {
        "type": "object",
        "description": "Opaque identities are scoped to an installation; no implicit cross-provider merge.",
        "required": [
          "installation_id",
          "content_type",
          "item_id"
        ],
        "properties": {
          "content_type": {
            "type": "string"
          },
          "installation_id": {
            "type": "string"
          },
          "item_id": {
            "type": "string"
          }
        }
      },
      "LibraryEntry": {
        "type": "object",
        "required": [
          "key",
          "title"
        ],
        "properties": {
          "key": {
            "$ref": "#/components/schemas/ItemKey"
          },
          "metadata": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Meta"
              }
            ]
          },
          "title": {
            "type": "string"
          }
        }
      },
      "Manifest": {
        "type": "object",
        "required": [
          "id",
          "version",
          "name",
          "resources",
          "types"
        ],
        "properties": {
          "addonCatalogs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Catalog"
            }
          },
          "behaviorHints": {
            "type": "object",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          },
          "catalogs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Catalog"
            }
          },
          "id": {
            "type": "string"
          },
          "idPrefixes": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "name": {
            "type": "string"
          },
          "resources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResourceDeclaration"
            }
          },
          "types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "version": {
            "type": "string"
          }
        },
        "additionalProperties": {}
      },
      "Meta": {
        "type": "object",
        "required": [
          "id",
          "type",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "videos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Video"
            }
          }
        },
        "additionalProperties": {}
      },
      "Overview": {
        "type": "object",
        "required": [
          "profiles"
        ],
        "properties": {
          "active_kids": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ProfileDto"
              }
            ]
          },
          "profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProfileDto"
            }
          },
          "selected": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ProfileDto"
              }
            ]
          },
          "snapshot": {
            "oneOf": [
              {
                "type": "null"
              },
              {
