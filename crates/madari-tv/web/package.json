{
  "name": "madari-tv-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "openapi": "cargo run -q --manifest-path ../../../Cargo.toml -p madari-tv --features openapi --example web_openapi > openapi.json",
    "codegen": "openapi-ts",
    "generate": "npm run openapi && npm run codegen",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "theme:build": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs theme build src/theme/madari-theme.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "0.5.4",
    "@heroicons/react": "^2.2.0",
    "@hey-api/client-fetch": "^0.13.1",
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-query": "^5.102.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@astryxdesign/build": "0.5.4",
    "@astryxdesign/cli": "0.5.4",
    "@hey-api/openapi-ts": "^0.99.0",
    "@stylexjs/unplugin": "0.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  }
}
